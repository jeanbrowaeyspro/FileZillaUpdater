<Project Sdk="Microsoft.NET.Sdk">

  <!-- Logique sans interface : versions, Chocolatey, signature, registre, GitHub,
       installation, réglages, textes, modèles de vue (sans référence à WPF). -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>FileZillaUpdater</RootNamespace>
  </PropertyGroup>

  <!-- Textes (classe L, interne) partagés avec l'application et les tests. -->
  <ItemGroup>
    <InternalsVisibleTo Include="FileZillaUpdater.App" />
    <InternalsVisibleTo Include="FileZillaUpdater.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\Shared\Switches.cs" Link="Switches.cs" />
    <Compile Include="..\Shared\AppLocations.cs" Link="AppLocations.cs" />
    <Compile Include="..\Shared\L.cs" Link="L.cs" />
    <Compile Include="..\Shared\FrenchCatalog.cs" Link="FrenchCatalog.cs" />
  </ItemGroup>

</Project>
